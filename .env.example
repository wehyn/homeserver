DATABASE_PATH=./data/nimbus.db
DOCKER_SOCKET=/var/run/docker.sock
# Optional bearer token shared by Nimbus and the Compose metrics agent.
MEMORY_AGENT_TOKEN=
# Optional Nimbus-to-agent override; defaults to the metrics agent above.
DOCKER_AGENT_URL=http://metrics-agent:8787
DOCKER_AGENT_TOKEN=
# Optional URL for a separately deployed read-only Docker API adapter. The adapter must
# allow only GET /containers/json, GET /containers/{id}/json, and GET
# /containers/{id}/stats?stream=false. Do not expose a Docker socket directly.
DOCKER_DISCOVERY_URL=
DOCKER_DISCOVERY_TOKEN=
# Optional server-side outage delivery. Leave empty to use browser-only alerts.
NIMBUS_NOTIFICATION_WEBHOOK_URL=
